          "content": {
            "mimeType": "application/json",
            "size": 749,
            "text": "[{\"type\":\"Banner\",\"class\":\"Information\",\"target\":[\"Home page\",\"Member search\",\"Member details\",\"Practice profile\"],\"title\":\"2026 National Wellcare Provider Webinar Trainings  Schedule -Michelle Carter\",\"heading\":\"Pre-register for National 2026 Wellcare Medicare Advantage provider webinar trainings\",\"body\":\"<p>The schedule of the 2026 National Wellcare Medicare Advantage provider webinar trainings has been posted within the&nbsp;<em>Provider Training</em>&nbsp;folder. Please pre-register for the dates and times that work best for your office's schedule each quarter. Official invitations will be distributed prior to each quarter's webinar offerings. We look forward to your future attendance!</p>\",\"id\":\"b204cf9a-8a48-402b-b919-550780d6128d\"}]"
          },
